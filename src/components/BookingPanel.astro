---
// Booking panel: filterable live room list + per-room booking forms.
// No-JS baseline: the filter form is a plain GET (reloads the page with
// query params, which building/[id].astro re-reads to re-render SSR); the
// room list and booking forms are fully functional plain HTML/HTTP forms.
// With JS: the filter form is intercepted and re-fetches /api/rooms.json,
// booking forms collapse behind "Book" links and submit via fetch.
import type { Building } from "../lib/campus";
import { roomStatusFor } from "../lib/bookings";
import RoomCard from "./RoomCard.astro";

interface Props {
  building: Building;
  date: string;
  time: string;
}

const { building, date, time } = Astro.props;
const liveRooms = building.rooms.map((room) => ({
  ...room,
  status: roomStatusFor(room, date, time),
}));
---

<aside class="booking-panel" id="booking-panel">
  <form class="booking-filters" id="filter-form" method="get">
    <input type="hidden" name="building" value={building.id} />
    <label>
      Date
      <input type="date" name="date" value={date} />
    </label>
    <label>
      Time
      <input type="time" name="time" value={time} />
    </label>
    <label>
      Status
      <select name="status">
        <option value="all">All</option>
        <option value="available">Available</option>
        <option value="busy">Busy</option>
        <option value="closed">Closed</option>
      </select>
    </label>
    <button type="submit">Apply filters</button>
  </form>

  <ul class="card-list room-list-live" id="room-list" data-building={building.id}>
    {liveRooms.map((room) => <RoomCard room={room} bookHref={`#book-${room.id}`} />)}
  </ul>

  {liveRooms.map((room) => (
    <form class="booking-form" id={`book-${room.id}`} method="POST" action="/api/bookings" data-room-id={room.id}>
      <h2>Book {room.name}</h2>
      <input type="hidden" name="roomId" value={room.id} />
      <input type="hidden" name="buildingId" value={building.id} />
      <label>
        Your name
        <input type="text" name="bookedBy" required />
      </label>
      <label>
        Date
        <input type="date" name="date" value={date} required />
      </label>
      <label>
        Start
        <input type="time" name="start" required />
      </label>
      <label>
        End
        <input type="time" name="end" required />
      </label>
      <button type="submit">Confirm booking</button>
      <div class="booking-feedback" hidden></div>
    </form>
  ))}
</aside>

<script type="module">
  const panel = document.getElementById("booking-panel");
  if (panel) {
    const roomList = panel.querySelector("#room-list");
    const filterForm = panel.querySelector("#filter-form");
    const buildingId = roomList?.dataset.building ?? "";

    const statusLabel = (status) => {
      if (status === "available") return "Available";
      if (status === "busy") return "Busy";
      if (status === "closed") return "Closed";
      return status;
    };

    function renderRoomCard(room) {
      const closed = room.status === "closed";
      const bookLink = closed
        ? `<a class="book-link disabled" href="#" aria-disabled="true" tabindex="-1">Book</a>`
        : `<a class="book-link" href="#book-${room.id}">Book</a>`;
      return `<li class="card" data-room-id="${room.id}">
        <div>
          <div class="card-title">${room.name}</div>
          <div class="card-meta">Capacity ${room.capacity} &middot; ${room.note}</div>
        </div>
        <div>
          <span class="badge badge-${room.status}">${statusLabel(room.status)}</span>
          ${bookLink}
        </div>
      </li>`;
    }

    // Hide all booking forms; reveal on demand via delegated click on the
    // "Book" links (event delegation so re-rendered cards keep working).
    const allBookingForms = () => Array.from(panel.querySelectorAll(".booking-form"));
    allBookingForms().forEach((f) => {
      f.hidden = true;
    });

    panel.addEventListener("click", (event) => {
      const link = event.target.closest(".book-link");
      if (!link) return;
      if (link.classList.contains("disabled") || link.getAttribute("aria-disabled") === "true") {
        event.preventDefault();
        return;
      }
      const href = link.getAttribute("href") || "";
      if (!href.startsWith("#book-")) return;
      event.preventDefault();
      const targetForm = panel.querySelector(href);
      if (!targetForm) return;
      allBookingForms().forEach((f) => {
        f.hidden = f !== targetForm;
      });
      targetForm.scrollIntoView({ behavior: "smooth", block: "center" });
      const firstInput = targetForm.querySelector("input:not([type=hidden])");
      if (firstInput) firstInput.focus();
    });

    // Progressive enhancement of the filter form: fetch + re-render instead
    // of a full page navigation.
    if (filterForm) {
      filterForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const date = filterForm.querySelector('[name="date"]')?.value ?? "";
        const time = filterForm.querySelector('[name="time"]')?.value ?? "";
        const status = filterForm.querySelector('[name="status"]')?.value ?? "all";
        try {
          const params = new URLSearchParams({ building: buildingId, date, time });
          const res = await fetch(`/api/rooms.json?${params.toString()}`);
          if (!res.ok) return;
          const data = await res.json();
          let rooms = data.rooms ?? [];
          if (status !== "all") {
            rooms = rooms.filter((r) => r.status === status);
          }
          if (roomList) {
            roomList.innerHTML = rooms.map(renderRoomCard).join("");
          }
        } catch (err) {
          // Prototype-grade: silently ignore fetch failures, filter form
          // still works as a normal GET without JS.
        }
      });
    }

    // Booking form submission via fetch, with inline feedback.
    allBookingForms().forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const feedback = form.querySelector(".booking-feedback");
        const fields = {
          roomId: form.querySelector('[name="roomId"]')?.value,
          buildingId: form.querySelector('[name="buildingId"]')?.value,
          bookedBy: form.querySelector('[name="bookedBy"]')?.value,
          date: form.querySelector('[name="date"]')?.value,
          start: form.querySelector('[name="start"]')?.value,
          end: form.querySelector('[name="end"]')?.value,
        };
        try {
          const res = await fetch("/api/bookings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(fields),
          });
          const data = await res.json();
          if (feedback) {
            feedback.hidden = false;
            if (data.ok) {
              feedback.textContent = "Booked!";
              feedback.className = "booking-feedback success";
              const roomId = fields.roomId;
              const li = roomList?.querySelector(`li[data-room-id="${roomId}"]`);
              if (li) {
                const badge = li.querySelector(".badge");
                const link = li.querySelector(".book-link");
                if (badge) {
                  badge.className = "badge badge-busy";
                  badge.textContent = "Busy";
                }
                if (link) {
                  link.classList.add("disabled");
                  link.setAttribute("aria-disabled", "true");
                  link.setAttribute("tabindex", "-1");
                  link.removeAttribute("href");
                }
              }
            } else {
              feedback.textContent = data.error || "Something went wrong.";
              feedback.className = "booking-feedback error";
            }
          }
        } catch (err) {
          if (feedback) {
            feedback.hidden = false;
            feedback.textContent = "Network error — please try again.";
            feedback.className = "booking-feedback error";
          }
        }
      });
    });
  }
</script>
