---
// Reusable status pill. Usage: <StatusBadge status={room.status} />
import type { RoomStatus } from "../lib/campus";
import { statusLabel } from "../lib/campus";

interface Props {
  status: RoomStatus;
}

const { status } = Astro.props;
---

<span class={`badge badge-${status}`}>{statusLabel(status)}</span>
